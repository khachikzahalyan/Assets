# AMS — Firebase environment variables
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
# For production, set these in the Vercel project dashboard
# (Settings -> Environment Variables).
#
# All variables must start with VITE_ to be exposed to the Vite client bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Seeder / Admin scripts (NEVER committed; used only by scripts/*.ts) ---
#
# Project id to target. May also be set via --project flag or .firebaserc default.
# GOOGLE_CLOUD_PROJECT=ams-yourproject
#
# Path to a service-account JSON key for real-project seeding.
# The .secrets/ directory and service-account*.json are gitignored.
# GOOGLE_APPLICATION_CREDENTIALS=./.secrets/service-account.json
#
# Set this to seed the local Firebase emulator instead of a real project.
# FIRESTORE_EMULATOR_HOST=localhost:8080
#
# Comma-separated list of allowed OAuth email domains written into settings/auth.
# IMPORTANT: if this is empty (or unset), the beforeCreate Cloud Function FAILS
# CLOSED and blocks ALL sign-ups — nobody can sign in, including the first
# super_admin. Always supply this when seeding a real project.
# SEED_ALLOWED_DOMAINS=yourcompany.example

# --- Access-notification email (Vercel serverless fn /api/notify-access) ---
#
# SERVER-SIDE ONLY (no VITE_ prefix — never exposed to the client bundle).
# Set these in the Vercel dashboard (Settings -> Environment Variables), then redeploy.
# The whole feature is $0: Vercel Hobby function + Brevo free tier (300 emails/day).
#
# Brevo transactional API key (Brevo -> SMTP & API -> API Keys).
# BREVO_API_KEY=
# Verified Brevo sender (Brevo -> Senders -> verify this address by email, one click).
# BREVO_SENDER_EMAIL=zahalyanxcho@gmail.com
# Sender display name + brand shown in the email header.
# BREVO_SENDER_NAME=AMS
# Absolute app URL used for the "Войти" button + fallback link.
# APP_URL=https://telcell-ams.vercel.app/
# Firebase project id — used to verify the caller's ID token + read their role.
# (Same value as VITE_FIREBASE_PROJECT_ID, just without the VITE_ prefix.)
# FIREBASE_PROJECT_ID=
