rules_version = '2';

// AMS — Asset Management System
// Deny-by-default Firestore security rules.
// Role is server-trusted: read from /users/{uid}.role via get(), NEVER from
// client-supplied custom claims. audit_logs are IMMUTABLE for everyone.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    // The caller's own users doc. Only call after isSignedIn().
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function isSuperAdmin() {
      return isSignedIn() && role() == 'super_admin';
    }

    function isAssetAdmin() {
      return isSignedIn() && role() == 'asset_admin';
    }

    function isTechAdmin() {
      return isSignedIn() && role() == 'tech_admin';
    }

    function isAnyAdmin() {
      return isSuperAdmin() || isAssetAdmin() || isTechAdmin();
    }

    // The caller's employees/{id} doc id. Invited employees (auto-provisioned via
    // the beforeCreate trigger) carry users/{uid}.employeeId pointing at an HR
    // record whose id differs from the auth uid; legacy employee accounts created
    // through the pending queue use employee doc id == uid. Same userDoc() get()
    // as role() — rules dedupe the read within a request evaluation.
    function myEmployeeId() {
      return ('employeeId' in userDoc()) ? userDoc().employeeId : request.auth.uid;
    }

    // True when `id` identifies the CALLER's employee record (either linkage).
    // A revoked/terminated account loses all self-scoped reads: the caller's own
    // users doc status must not be 'terminated'. Uses the Map .get('status','')
    // form so a legacy users doc lacking status resolves to '' (!= 'terminated' →
    // pass); a caller with NO users doc at all already errors inside userDoc()/
    // myEmployeeId() → deny (unchanged). Same userDoc() get() as role() — deduped.
    function isSelfEmployee(id) {
      return isSignedIn()
        && userDoc().get('status', '') != 'terminated'
        && (id == request.auth.uid || id == myEmployeeId());
    }

    // Whenever a `role` field is present in the written data it must be one of the
    // four valid roles. Applies to ALL writers (incl. super) so a garbage/legacy
    // role string (e.g. 'admin') can never be persisted.
    function validRoleIfPresent() {
      return !('role' in request.resource.data)
        || request.resource.data.role in ['super_admin', 'asset_admin', 'tech_admin', 'employee'];
    }

    // ---- /users ----
    // Read: self or super_admin. Create/delete + role/status changes: super_admin only.
    // A signed-in user may update their OWN doc only if role + status are unchanged
    // (prevents self role-escalation).
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());

      // $0 (no Cloud Functions) invited-employee → role fallback. A user may write
      // their OWN users doc with a role ONLY IF that role EQUALS the preassignedRole
      // of the ACTIVE employees record whose email matches their auth token. Since
      // preassignedRole can only be set by a super_admin (see /employees rules) and
      // emails are unique per employee, this lets an invitee claim exactly the role
      // an admin already intended — never an arbitrary role. Normally the
      // beforeCreate blocking function does this; on Spark the client does it.
      // The get()s are short-circuit-guarded by the preceding exists().
      function claimsPreassignedRole() {
        let empId = request.resource.data.employeeId;
        let empPath = /databases/$(database)/documents/employees/$(empId);
        return isSignedIn()
          && request.auth.uid == uid
          // Anchor the identity on a VERIFIED email — never trust an unverified
          // token.email for a privilege grant (defense vs. a future password provider).
          && request.auth.token.email_verified == true
          // The stored email must BE the caller's token email — a self-claimed
          // doc may never carry a foreign address (the sign-up duplicate guard
          // reads /users.email, so a planted value could deny that person entry).
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'active'
          && empId is string
          && request.resource.data.role in ['super_admin', 'asset_admin', 'tech_admin', 'employee']
          // Fill a FIRST role only — never override an existing users.role, so a
          // super_admin demotion can't be reverted via a stale preassignedRole.
          && (resource == null || !('role' in resource.data) || resource.data.status == 'no-role')
          // No stray fields on the self-written doc.
          && request.resource.data.keys().hasOnly(
               ['email', 'displayName', 'role', 'employeeId', 'status', 'createdAt', 'updatedAt'])
          && exists(empPath)
          && get(empPath).data.email == request.auth.token.email
          // Allowlist (not a 'terminated' denylist): only a genuinely ACTIVE
          // employee record can back a claim.
          && get(empPath).data.status == 'active'
          && get(empPath).data.preassignedRole == request.resource.data.role;
      }

      // A self-written employeeId must point at the CALLER'S OWN employees record:
      // the target doc's email must equal the caller's VERIFIED token email
      // (case-insensitive — employees.email may be stored mixed-case while
      // token.email is normalized, or vice versa). employeeId == null (unlink)
      // is allowed without a get(). Terminated records cannot be linked.
      // Fail-closed: a missing employees doc, missing email field, or missing
      // token email makes the expression error/false -> deny.
      function selfEmployeeIdOk() {
        let e = request.resource.data.employeeId;
        return e == null
          || (
            e is string
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/employees/$(e))
            && get(/databases/$(database)/documents/employees/$(e)).data.email.lower()
                 == request.auth.token.email.lower()
            && get(/databases/$(database)/documents/employees/$(e)).data.get('status', '') != 'terminated'
          );
      }

      // Offboarding revocation: an admin who can terminate employees (super | asset)
      // may REVOKE a login account — drop its role and set status 'terminated' so it
      // no longer grants access. Pure de-escalation (role is removed, never granted
      // or raised) and never against a super_admin account. Used by archiveEmployee
      // to disable a fired person's account on the $0 (no Cloud Functions) plan.
      function revokesAccount() {
        return (isSuperAdmin() || isAssetAdmin())
          && resource != null
          && resource.data.role != 'super_admin'
          && !('role' in request.resource.data)
          && request.resource.data.status == 'terminated'
          // Revocation must NEVER touch the HR linkage — otherwise this de-escalation
          // arm (which has no key whitelist) would let an admin plant a foreign
          // employeeId in the same write, bypassing selfEmployeeIdOk().
          && !('employeeId' in request.resource.data.diff(resource.data).affectedKeys());
      }

      // Create: super_admin (any shape) OR a self-claim of a no-role record that
      // introduces NO role field OR a preassigned-role self-claim (see above).
      allow create: if validRoleIfPresent() && (
          isSuperAdmin()
          || (
            isSignedIn()
            && request.auth.uid == uid
            && !('role' in request.resource.data)
            && request.resource.data.status == 'no-role'
            && (!('employeeId' in request.resource.data) || selfEmployeeIdOk())
          )
          || claimsPreassignedRole()
        );

      // Update: super_admin (any shape) OR a self-update that changes NO role
      // field and keeps status unchanged (self can never grant/raise a role) OR a
      // preassigned-role self-claim (upgrades a prior no-role record).
      allow update: if validRoleIfPresent() && (
          isSuperAdmin()
          || (
            isSignedIn()
            && request.auth.uid == uid
            && !('role' in request.resource.data.diff(resource.data).affectedKeys())
            && request.resource.data.status == resource.data.status
            && (!('employeeId' in request.resource.data.diff(resource.data).affectedKeys()) || selfEmployeeIdOk())
          )
          || claimsPreassignedRole()
          || revokesAccount()
        );

      allow delete: if isSuperAdmin();
    }

    // ---- /assets ----
    // Read: any admin, OR the employee who has the asset currently assigned to them.
    //   assignment.employeeId is null-guarded: if assignment is null (warehouse) or
    //   employeeId is absent, the condition short-circuits to false (fail-closed).
    // Write: super | asset_admin (full write — create, update, delete).
    // Update (tech_admin, constrained): tech_admin may ONLY flip the repair-workflow
    //   statusId. The write must touch nothing beyond statusId + the two bookkeeping
    //   fields (updatedAt, updatedBy) and the new statusId must be one of the three
    //   repair-workflow values. Assignment, branchId, categoryId, invCode, serial,
    //   etc. are untouchable by tech_admin.
    match /assets/{id} {
      allow read: if isAnyAdmin()
        || (
          isSignedIn()
          && resource.data.assignment != null
          && resource.data.assignment.employeeId != null
          && isSelfEmployee(resource.data.assignment.employeeId)
        );
      allow write: if isSuperAdmin() || isAssetAdmin();
      allow update: if isTechAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['statusId', 'upgradeCurrent', 'updatedAt', 'updatedBy'])
        && request.resource.data.statusId in ['st_repair', 'st_assigned', 'st_warehouse'];

      // Upgrade events: append-only business trail. tech_admin and super_admin only
      // (tech attributes / component upgrades are tech_admin per the role matrix).
      match /upgrades/{upgradeId} {
        allow read: if isSignedIn();
        allow create: if isSuperAdmin() || isTechAdmin();
        allow update, delete: if false;
      }
    }
    // ---- /licenses — workstation/employee licenses ----
    // Read: any admin (device-detail license listing). Write: super | tech_admin
    //   (tech_admin manages licenses per the role matrix). NO employee read.
    // Secrets sub-collection: gated to super_admin OR tech_admin (the two roles
    //   that can manage licenses). Raw keys are written/read directly via the
    //   client SDK; masking is enforced in app code (sanitizeLicenseAuditPayload)
    //   before audit_logs entries are written. asset_admin, employee, and
    //   unauthenticated callers are denied.
    match /licenses/{id} {
      allow read: if isAnyAdmin();
      // A raw `key` field must NEVER live on the license doc — keys belong in the
      // secrets sub-collection only. Reject any doc write carrying `key`,
      // so even a privileged admin client cannot bypass the masking architecture.
      allow write: if (isSuperAdmin() || isTechAdmin())
        && !('key' in request.resource.data);
      match /secrets/{s} {
        allow read, write: if isSuperAdmin() || isTechAdmin();
      }
    }

    // ---- /subscriptions — seat-based SaaS subscriptions ----
    // Read: super_admin OR tech_admin only. The Licenses route is gated to
    //   these two roles; subscription assignee lists are employee PII that
    //   asset_admin does not need to access.
    // Write (create/update): super_admin OR tech_admin. Shape guard requires
    //   assignedEmployeeIds to be a list — defense-in-depth against a malformed
    //   privileged client corrupting the field.
    // Delete: forbidden for all principals.
    match /subscriptions/{id} {
      allow read: if isSuperAdmin() || isTechAdmin();
      allow create, update: if (isSuperAdmin() || isTechAdmin())
        && request.resource.data.assignedEmployeeIds is list;
      allow delete: if false;
    }

    // ---- /server_licenses — global/server/company-wide licenses ----
    // Super-admin WRITE only. Read: any admin.
    // Secrets sub-collection: super_admin only (server licenses are more sensitive
    //   than workstation licenses; tech_admin cannot manage server licenses, so
    //   they cannot access their secrets either).
    match /server_licenses/{id} {
      allow read: if isAnyAdmin();
      // Same key-field guard as /licenses: raw keys live only in secrets/*.
      allow write: if isSuperAdmin()
        && !('key' in request.resource.data);
      match /secrets/{s} {
        allow read, write: if isSuperAdmin();
      }
    }

    match /branches/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin() || isAssetAdmin();
    }
    // ---- /employees ----
    // Read: any admin, OR the employee reading their OWN doc (self-service profile).
    // Create/Update: super | asset_admin. Email non-empty; identity (first/last name)
    //   is immutable after creation.
    // Termination is an IN-PLACE status flip (status: 'terminated') via update — NOT a
    //   delete. archiveEmployee also revokes the linked users/{uid} account (see the
    //   /users revokesAccount() rule). Do NOT reintroduce a delete-and-move-to-
    //   former_employees flow: former_employees is legacy read-only for old archived
    //   data; the in-place flip is the source of truth.
    // Delete: super | asset_admin — retained for genuine hard-deletes only, not for
    //   the termination path.
    match /employees/{id} {
      // Read: any admin; the employee reading their OWN doc (by uid or linked
      // employeeId); OR a signed-in user reading the record whose email matches
      // their auth token — this lets a not-yet-linked employee discover their HR
      // record by email (client self-heal of users/{uid}.employeeId). Emails are
      // unique per employee, so this exposes only the caller's own record.
      allow read: if isAnyAdmin()
        || isSelfEmployee(id)
        || (isSignedIn() && resource.data.email.lower() == request.auth.token.email.lower());
      // preassignedRole (the role granted to a person BEFORE first sign-in) is a
      // privilege grant, so it must be a valid role AND may only be introduced by
      // a super_admin. Helper reused by create + update.
      function validPreassign() {
        return !('preassignedRole' in request.resource.data)
          || request.resource.data.preassignedRole == null
          || request.resource.data.preassignedRole in ['super_admin', 'asset_admin', 'tech_admin', 'employee'];
      }
      allow create: if (isSuperAdmin() || isAssetAdmin())
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && validPreassign()
        && (isSuperAdmin() || !('preassignedRole' in request.resource.data));
      // asset_admin edits to other fields must leave preassignedRole untouched.
      // Identity is immutable: firstName/lastName can never change after creation
      // (only email/position/phone/department are editable) — enforced server-side,
      // not just in the edit form. A same-value write is fine (unchanged key isn't
      // in affectedKeys); only an actual rename is rejected.
      allow update: if (isSuperAdmin() || isAssetAdmin())
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && validPreassign()
        && !('firstName' in request.resource.data.diff(resource.data).affectedKeys())
        && !('lastName' in request.resource.data.diff(resource.data).affectedKeys())
        && (isSuperAdmin()
            || !('preassignedRole' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isSuperAdmin() || isAssetAdmin();
    }

    // ---- /former_employees — LEGACY archive collection ----
    // Current terminations are an in-place status flip on /employees (see above);
    // this collection is NOT written by that path. It remains only for backward
    // compatibility: reading old archived docs (name resolution in history / the
    // Архив list) and the restore-from-legacy fallback. NO employee self-read.
    // Create/Update/Delete: super | asset_admin — kept for the legacy restore
    //   fallback and any one-off migration of pre-existing archive docs.
    match /former_employees/{id} {
      allow read: if isAnyAdmin();
      allow create, update: if (isSuperAdmin() || isAssetAdmin())
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow delete: if isSuperAdmin() || isAssetAdmin();
    }

    // ---- Reference catalogs: read any signed-in, write super only ----
    match /asset_statuses/{id} {
      allow read: if isSignedIn();
      // create: super only; new docs must be non-system (clients cannot mint system statuses)
      allow create: if isSuperAdmin()
        && (!('isSystem' in request.resource.data) || request.resource.data.isSystem == false);
      // update: super only; isSystem is immutable for all docs (blocks both promotion and
      // demotion); a system doc also freezes isFinal.
      // The clamp `(req.isSystem==true)==(res.isSystem==true)` handles absent isSystem
      // correctly: absent resolves to null, null==true is false, so a doc without isSystem
      // can only be updated if the write keeps it not-true (absent/false stays absent/false).
      allow update: if isSuperAdmin()
        && (
          (request.resource.data.isSystem == true) == (resource.data.isSystem == true)
        )
        && (
          resource.data.isSystem != true
          || request.resource.data.isFinal == resource.data.isFinal
        );
      // delete: super only AND never a system doc
      allow delete: if isSuperAdmin() && resource.data.isSystem != true;
    }
    match /categories/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    // Category groups (managed taxonomy) — same access model as /categories: any
    // signed-in user reads; only super_admin mutates. Read by the /assets/new group
    // step (Устройства / Сетевые устройства / Мебель). Without this rule the catch-all
    // denies the read and the group step silently vanishes (fail-soft → empty list).
    match /categoryGroups/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
    // Departments are reference/catalog data (§5): super_admin only may mutate.
    match /departments/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ---- /assignments ----
    // Read: any admin, OR the employee whose assignedToEmployeeId matches their uid.
    //   Branch-mode assignments have assignedToEmployeeId == null; null != uid is false
    //   (fail-closed) and does not throw — safe without an extra null guard.
    // Create: super | asset_admin. Update: super | asset_admin but ONLY
    //   endedAt / transferComment may change. Never deletable.
    match /assignments/{id} {
      allow read: if isAnyAdmin()
        || (
          isSignedIn()
          && resource.data.assignedToEmployeeId != null
          && isSelfEmployee(resource.data.assignedToEmployeeId)
        );
      allow create: if isSuperAdmin() || isAssetAdmin();
      allow update: if (isSuperAdmin() || isAssetAdmin())
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['endedAt', 'transferComment']);
      allow delete: if false;
    }

    // ---- /audit_logs — IMMUTABLE ----
    // Reads scoped by role. Creates allowed for any signed-in user (writes happen
    // inside withAudit transactions in app code; tightened in a later plan).
    // UPDATE and DELETE are forbidden for EVERYONE, including super_admin. This is
    // the hard security invariant of the system.
    match /audit_logs/{id} {
      allow read: if isAnyAdmin()
        || (
          isSignedIn()
          && resource.data.entityType == 'assignment'
          && resource.data.after != null
          && resource.data.after.assignedToEmployeeId != null
          && isSelfEmployee(resource.data.after.assignedToEmployeeId)
        );
      // create: server-trusted actor + time, required/allowed key sets, and shape guards
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == role()
        && request.resource.data.at == request.time
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() > 0
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && (!('before' in request.resource.data)
            || request.resource.data.before == null
            || request.resource.data.before is map)
        && (!('after' in request.resource.data)
            || request.resource.data.after == null
            || request.resource.data.after is map)
        && (!('comment' in request.resource.data)
            || request.resource.data.comment == null
            || request.resource.data.comment is string)
        && (!('actorName' in request.resource.data)
            || request.resource.data.actorName == null
            || request.resource.data.actorName is string)
        && request.resource.data.keys().hasAll(
             ['entityType', 'entityId', 'action', 'actorUid', 'actorRole', 'at'])
        && request.resource.data.keys().hasOnly(
             ['entityType', 'entityId', 'action', 'actorUid', 'actorRole',
              'before', 'after', 'comment', 'actorName', 'at']);
      allow update, delete: if false;
    }

    // ---- /notifications — bell events (receipt confirmed / role activated) ----
    // Read is scoped by audience: any admin sees 'admins'; only super_admin sees
    // 'super_admin'. receipt_confirmed docs are written by the Vercel confirm
    // functions via the service account (bypasses rules). The ONLY client create
    // is the first-login role_activated self-report (userUid must be the caller).
    // Updates may only append the caller's own uid to readBy (mark-as-read).
    // Nothing is ever deleted from the client.
    match /notifications/{id} {
      allow read: if (isAnyAdmin() && resource.data.audience == 'admins')
        || (isSuperAdmin() && resource.data.audience == 'super_admin');
      allow create: if isSignedIn()
        && request.resource.data.type == 'role_activated'
        && request.resource.data.audience == 'super_admin'
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.readBy is list
        && request.resource.data.readBy.size() == 0
        && request.resource.data.userName is string
        && request.resource.data.userEmail is string
        && request.resource.data.roleId is string
        && request.resource.data.keys().hasAll(
             ['type', 'audience', 'userUid', 'userName', 'userEmail', 'roleId', 'createdAt', 'readBy'])
        && request.resource.data.keys().hasOnly(
             ['type', 'audience', 'userUid', 'userName', 'userEmail', 'roleId', 'createdAt', 'readBy']);
      allow update: if ((isAnyAdmin() && resource.data.audience == 'admins')
          || (isSuperAdmin() && resource.data.audience == 'super_admin'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && request.resource.data.readBy.hasAll(resource.data.readBy)
        && request.resource.data.readBy.size() <= resource.data.readBy.size() + 1
        && request.auth.uid in request.resource.data.readBy;
      allow delete: if false;
    }

    // ---- /mail — Trigger Email queue. Write-only for admins; never client-readable. ----
    match /mail/{id} {
      allow create: if isSuperAdmin() || isAssetAdmin();
      allow read, update, delete: if false;
    }

    // ---- /settings/auth — OAuth allowed-domain doc (super only) ----
    // Read+write super_admin only. allowedEmailDomains, when present, must be a list
    // (rules can't deep-validate each element; the repo + beforeCreate enforce that).
    // beforeCreate reads this via Admin SDK and bypasses rules.
    match /settings/auth {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin()
        && (!('allowedEmailDomains' in request.resource.data)
            || request.resource.data.allowedEmailDomains is list);
    }

    // ---- /settings/{doc} — any other settings doc, super only ----
    // The `doc != 'auth'` guard on write ensures the more-specific /settings/auth block
    // is the SOLE write path for that document; the list-guard above cannot be bypassed
    // by the wildcard match's looser allow write condition.
    match /settings/{doc} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin() && doc != 'auth';
    }

    // ---- /part_categories — dynamic parts-warehouse category catalog ----
    // Read: any signed-in admin-capable principal (same audience as /parts).
    // Write: super_admin only. behavior is part of the doc but immutability is
    // enforced app-side (update rule still whitelists keys + type-guards).
    match /part_categories/{id} {
      allow read: if isSignedIn();

      allow create: if isSuperAdmin()
        && request.resource.data.name.ru is string && request.resource.data.name.ru.size() > 0
        && request.resource.data.name.en is string
        && request.resource.data.name.hy is string
        && request.resource.data.behavior in ['single', 'sized', 'models']
        && request.resource.data.slotKind is string
        && request.resource.data.order is number
        && request.resource.data.active is bool
        && request.resource.data.keys().hasOnly([
             'name', 'icon', 'tintToken', 'order', 'behavior', 'slotKind',
             'storageType', 'familyOverrides', 'variants', 'generations',
             'active', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy']);

      allow update: if isSuperAdmin()
        && request.resource.data.behavior == resource.data.behavior   // immutable class
        && request.resource.data.name.ru is string && request.resource.data.name.ru.size() > 0
        && request.resource.data.active is bool
        && request.resource.data.keys().hasOnly([
             'name', 'icon', 'tintToken', 'order', 'behavior', 'slotKind',
             'storageType', 'familyOverrides', 'variants', 'generations',
             'active', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy']);

      allow delete: if false;
    }

    // ---- /parts — SKU catalog ----
    // Read + create + update: three admin roles. No client delete (MVP boundary —
    // deleteGpu is routed through a Cloud Function in a post-MVP plan).
    // Shape guards:
    //   · category must reference an existing part_categories doc.
    //   · name must be a non-empty string.
    //   · numeric snapshot fields (onHand, broken, lowStockThreshold) must be numbers.
    //   · attribution: createdBy/updatedBy must equal the caller's uid.
    //   · allowed keys whitelist (optional fields: variantId, variantLabel, ddr).
    match /parts/{id} {
      allow read: if isSignedIn() && role() in ['super_admin', 'asset_admin', 'tech_admin'];

      allow create: if isSignedIn()
        && role() in ['super_admin', 'asset_admin', 'tech_admin']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && exists(/databases/$(database)/documents/part_categories/$(request.resource.data.category))
        && request.resource.data.onHand is number
        && request.resource.data.onHand >= 0
        && request.resource.data.broken is number
        && request.resource.data.broken >= 0
        && request.resource.data.lowStockThreshold is number
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'name', 'category', 'unit', 'onHand', 'broken', 'lowStockThreshold',
             'variantId', 'variantLabel', 'ddr',
             'createdAt', 'updatedAt', 'createdBy', 'updatedBy']);

      allow update: if isSignedIn()
        && role() in ['super_admin', 'asset_admin', 'tech_admin']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && exists(/databases/$(database)/documents/part_categories/$(request.resource.data.category))
        && request.resource.data.onHand is number
        && request.resource.data.onHand >= 0
        && request.resource.data.broken is number
        && request.resource.data.broken >= 0
        && request.resource.data.lowStockThreshold is number
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'name', 'category', 'unit', 'onHand', 'broken', 'lowStockThreshold',
             'variantId', 'variantLabel', 'ddr',
             'createdAt', 'updatedAt', 'createdBy', 'updatedBy']);

      allow delete: if false;
    }

    // ---- /part_movements — append-only stock journal ----
    // Immutable like audit_logs: update and delete forbidden for ALL principals.
    // Create allowed for the three admin roles, with server-trusted attribution guards
    // (mirroring audit_logs create) so forged actorUid/actorRole/at can never persist:
    //   · actorUid   must equal the caller's uid.
    //   · actorRole  must equal the caller's server-verified role (read from /users/{uid}).
    //   · at         must equal request.time (server timestamp — rules compare timestamps).
    //   · type       must be one of the four defined MovementType values.
    //   · keys()     are whitelisted; optional fields (assetId, assetInvCode, note, reason,
    //                kindId, kindLabel, serviceActorName, and the replace-install
    //                denormalisation replacedSpec / replacedStorageType /
    //                replacedSlotIndex / oldDisposal) may be absent but are the ONLY
    //                extras allowed.
    match /part_movements/{id} {
      allow read: if isSignedIn() && role() in ['super_admin', 'asset_admin', 'tech_admin'];

      allow create: if isSignedIn()
        && role() in ['super_admin', 'asset_admin', 'tech_admin']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == role()
        && request.resource.data.at == request.time
        && request.resource.data.type in ['receive', 'install', 'uninstall', 'service']
        && request.resource.data.keys().hasOnly([
             'type', 'skuId', 'qty', 'broken', 'assetId', 'assetInvCode',
             'serviceReplace', 'note', 'reason', 'kindId', 'kindLabel',
             'replacedSpec', 'replacedStorageType', 'replacedSlotIndex', 'oldDisposal',
             'serviceActorName',
             'actorUid', 'actorRole', 'at']);

      allow update, delete: if false;
    }

    // ---- /barcodes/{code} — uniqueness lock for asset barcodes ----
    // Created (once) when an asset reserves its barcode. Immutable; never updated.
    match /barcodes/{code} {
      allow read:   if isAnyAdmin();
      allow create: if isSuperAdmin() || isAssetAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ---- /inv_codes/{code} — uniqueness lock for asset inventory codes ----
    // Mirrors /barcodes/{code}. lockId = encodeURIComponent(invCode.trim()) so '/'
    // characters in inventory codes (e.g. "450/1") are safely encoded as '%2F'.
    // Written atomically inside the same withAudit transaction as the asset doc
    // in createAsset/createAssetsBatch — prevents TOCTOU duplicates under concurrency.
    match /inv_codes/{code} {
      allow read:   if isAnyAdmin();
      allow create: if isSuperAdmin() || isAssetAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ---- Catch-all: deny everything not matched above ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
